{
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "ng",
          "commands": ["cd client"]
        },
        {
          "name": "ng serve",
          "commands": ["cd client", "ng serve"]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "server",
          "commands": ["cd server"]
        },
        {
          "name": "nodemon",
          "commands": ["npm run server"]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "studio",
          "commands": ["cd studio"]
        },
      ]
    }
  ],
  "postman.settings.dotenv-detection-notification-visibility": false,
  "xliffSync.baseFile": "messages.xlf"
}
